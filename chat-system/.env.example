# Copy to .env and uncomment ONE machine block. .env is gitignored; THIS file is the shared template.
# One .env, three prefixes: CHAT__* (this module), RAG__* (retrieval: OpenSearch, embeddings, THE LLM), USERS__* (users).
# pydantic-settings reads .env from the working directory, so run everything from chat-system/.
# Never put HTTP(S)_PROXY here: every endpoint is loopback or a tunnel and the HTTP clients ignore the proxy environment.

# ============================ machine block: DEV BOX (WSL2) ==================================================
#   OpenSearch node from opensearch-index (make up), LiteLLM proxy on :4000 (bge-m3 via Ollama, gemini-dev)
CHAT__DB__URL=sqlite:///./data/chat.db
# CHAT__DB__URL=postgresql+psycopg://chat:${POSTGRES_PASSWORD:-chat}@127.0.0.1:5432/chat   # after `make db-up`
CHAT__UI__ALLOW_USER_SWITCH=true              # sidebar user selectbox = the simulated ingress (dev only)
CHAT__RETRIEVAL__K=8
CHAT__RETRIEVAL__K_GRAPH=12
RAG__OPENSEARCH__URL=http://localhost:9200
RAG__INDEX__PREFIX=bhb
RAG__EMBEDDING__BASE_URL=http://localhost:4000/v1
RAG__EMBEDDING__API_KEY=sk-123456789
RAG__EMBEDDING__MODEL=bge-m3
RAG__EMBEDDING__DIM=1024
RAG__EMBEDDING__QUERY_PREFIX=
RAG__LLM__BASE_URL=http://localhost:4000/v1
RAG__LLM__API_KEY=sk-123456789
RAG__LLM__MODEL=gemini-dev                    # the ONLY place the chat model is configured
# RAG__LLM__MAX_TOKENS=4000                   # gemini-3.7-flash thinks ~1300 tokens before answering
# RAG__RETRIEVAL__HISTORY_TURNS=3             # user/assistant pairs the prompt carries (REQ-001 R7); 10 for large-context models
# RAG__LLM__MODEL=granite4                    # CPU-only Ollama model: slow, small context -> also set
# RAG__LLM__CONTEXT_LIMIT_TOKENS=4096         #   CHAT__RETRIEVAL__K=4 CHAT__RETRIEVAL__K_GRAPH=6 RAG__RETRIEVAL__CONTEXT_TOKEN_BUDGET=2500
# RAG__LLM__BASE_URL=http://localhost:11434/v1   # Ollama directly (no key), e.g. RAG__LLM__MODEL=gemma4:e2b
RAG__ONTOLOGY__PATH=../user-manual-books/handbuch_daten/Ontologie/ontology.yaml
USERS__ADAPTER=env
USERS__DEV_USER=dev
POSTGRES_PASSWORD=chat                        # compose profile postgres (make db-up); change it before exposing anything

# ============================ machine block: REMOTE SERVER (vLLM Qwen3-Coder-30B + multilingual-e5-large) ====
#   rootless podman behind the `docker` alias, SELinux enforcing, endpoints through SSH tunnels on the host loopback.
#   The chunks there were embedded with intfloat/multilingual-e5-large + "passage: " -> query needs the same model + "query: ".
# CHAT__DB__URL=postgresql+psycopg://chat:<password>@postgres:5432/chat    # inside compose (up-enterprise); host: @127.0.0.1:5432
# CHAT__UI__ALLOW_USER_SWITCH=false
# CHAT__RETRIEVAL__K=8
# CHAT__RETRIEVAL__K_GRAPH=12
# RAG__OPENSEARCH__URL=http://localhost:9200
# RAG__EMBEDDING__BASE_URL=http://localhost:11435/v1
# RAG__EMBEDDING__API_KEY=
# RAG__EMBEDDING__MODEL=intfloat/multilingual-e5-large
# RAG__EMBEDDING__DIM=1024
# RAG__EMBEDDING__QUERY_PREFIX="query: "
# RAG__LLM__BASE_URL=http://localhost:11435/v1
# RAG__LLM__API_KEY=
# RAG__LLM__MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
# RAG__LLM__CONTEXT_LIMIT_TOKENS=32000
# RAG__RETRIEVAL__HISTORY_TURNS=10            # large served context: keep 10 exchanges in the prompt (REQ-001 R7)
# RAG__ONTOLOGY__PATH=/ontology/ontology.yaml            # inside the container (ONTOLOGY_DIR is mounted there); host venv: /srv/rag/user-manual-books/handbuch_daten/Ontologie/ontology.yaml
# USERS__ADAPTER=env                                     # header once oauth2-proxy sits in front (USERS__HEADER_* = its header names)
# USERS__DEV_USER=dev
# POSTGRES_PASSWORD=<password>
# CHAT_BIND=127.0.0.1                                    # published address of the UI; reach it through ssh -L 8501:localhost:8501
# CHAT_PORT=8501
# SELINUX_LABEL=,Z                                       # SELinux enforcing: relabel bind mounts
# ONTOLOGY_DIR=/srv/rag/user-manual-books/handbuch_daten/Ontologie
# ---- image build args (docker compose --profile local build) ----
# BASE_IMAGE=<registry>/python:3.12-slim
# PIP_INDEX_URL=https://<artifactory>/api/pypi/<repo>/simple
# PIP_TRUSTED_HOST=                                      # only if pip reports CERTIFICATE_VERIFY_FAILED
