# database_comparison/.env — Vorlage. Kopieren nach .env (gitignored) und Werte eintragen.
# Zelle 1 des Notebooks lädt diese Datei; rag_retrieval (RAG__*) und opensearch_index (OSI__*) lesen sie direkt.

# ---- Modelle, lokal (LiteLLM-Dienst auf diesem Rechner) -------------------------------------------------------
RAG__LLM__BASE_URL=http://localhost:4000/v1
RAG__LLM__API_KEY=sk-...
RAG__LLM__MODEL=gemini-dev
RAG__EMBEDDING__BASE_URL=http://localhost:4000/v1
RAG__EMBEDDING__API_KEY=sk-...
RAG__EMBEDDING__MODEL=bge-m3
RAG__EMBEDDING__DIM=1024
RAG__EMBEDDING__QUERY_PREFIX=

# ---- Modelle, entfernt (OpenAI-kompatibler Endpunkt) — zum Umschalten oben in die RAG__*-Zeilen eintragen -------
REMOTE_BASE_URL=https://example.duckdns.org:8684/v1
REMOTE_API_KEY=...
REMOTE_LLM_MODEL=ministral-3:8b

# ---- OpenSearch (lokaler Container aus opensearch-index/, dort `make up`) --------------------------------------
RAG__OPENSEARCH__URL=http://localhost:9200
OSI__OPENSEARCH__URL=http://localhost:9200
OSI__EMBEDDING__MODEL=bge-m3
OSI__EMBEDDING__DIM=1024
OSI__EMBEDDING__TEXT_PREFIX=
OSI__ONTOLOGY__PATH=../user-manual-books/handbuch_daten/Ontologie/ontology.yaml
RAG__ONTOLOGY__PATH=../user-manual-books/handbuch_daten/Ontologie/ontology.yaml

# ---- Notebook ---------------------------------------------------------------------------------------------------
RUN_DIRS=../out/remote-zsd,../out/remote-caas,../out/remote-system-event
SQLITE_PATH=data/search.db
ZVEC_PATH=data/zvec
