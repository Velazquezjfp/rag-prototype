# Vorlage: nach .env kopieren und ausfüllen. .env steht in .gitignore, diese Datei ist die gemeinsame Vorlage.
# Zwei Gruppen: INGEST__* (dieser Dienst) und OSI__* (Verbindung zu OpenSearch, dieselben Variablen wie beim Indexer).
# Die Werte werden aus .env im Arbeitsordner gelesen: alles aus dem Ordner ingest/ starten.
# Keine Proxy-Variablen hier eintragen: compose gibt diese Datei auch an den laufenden Container. Der Proxy ist nur
# für den Build nötig und kommt aus der Shell (HTTP_PROXY, HTTPS_PROXY, NO_PROXY).
# Embedding-Modell und Vektorgröße stehen nicht hier: der Dienst liest sie aus dem Index und fragt dgs.

# ---- Pflicht ------------------------------------------------------------------------------------------------
# Schlüssel für den Header X-API-Key. Lang und zufällig, zum Beispiel:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST__API_KEY=

# ---- docling-graph-service ----------------------------------------------------------------------------------
INGEST__DGS__URL=http://localhost:8080
# INGEST__DGS__TIMEOUT_S=3600          # Wartezeit je Dokument; größer als DGS__SERVICE__REQUEST_DEADLINE_S
# INGEST__DGS__BUSY_RETRY_S=30         # Pause, solange dgs ein anderes Dokument verarbeitet

# ---- OpenSearch (schreiben) ---------------------------------------------------------------------------------
OSI__OPENSEARCH__URL=http://localhost:9200
# OSI__OPENSEARCH__USERNAME=bhb_writer
# OSI__OPENSEARCH__PASSWORD=
# OSI__OPENSEARCH__VERIFY_CERTS=true   # false nur zum Testen mit einem selbst signierten Zertifikat
# OSI__OPENSEARCH__CA_CERTS=/pfad/zur/ca.pem

# ---- Ontologie und Index ------------------------------------------------------------------------------------
# Start ohne Container: die Standardwerte zeigen auf ../user-manual-books/handbuch_daten/Ontologie/ontology.yaml.
# Im Container (compose) liegt die Ontologie fest unter /ontology; diese Zeilen sind dort ohne Wirkung.
# INGEST__ONTOLOGIES='{"bhb": "../user-manual-books/handbuch_daten/Ontologie/ontology.yaml"}'   # Name -> Datei
# OSI__ONTOLOGY__PATH=../user-manual-books/handbuch_daten/Ontologie/ontology.yaml              # nur für den Befehl osi
# INGEST__DEFAULT_PREFIX=bhb           # Index-Präfix, wenn der Aufruf keinen nennt

# ---- Grenzen und Log ----------------------------------------------------------------------------------------
# INGEST__MAX_UPLOAD_MB=50
# INGEST__JOBS_KEEP=50                 # so viele fertige Aufträge zeigt GET /v1/jobs
# INGEST__LOG_LEVEL=INFO

# ---- nur für docker compose ---------------------------------------------------------------------------------
# INGEST_BIND=127.0.0.1                # Adresse, auf der die API erreichbar ist
# INGEST_PORT=8090
# INGEST_IMAGE=ingest-service:local
# ONTOLOGY_DIR=../user-manual-books/handbuch_daten/Ontologie    # Ordner mit ontology.yaml, eingehängt als /ontology
# SELINUX_LABEL=,Z                     # nur mit SELinux (RHEL, CentOS)

# ---- Build des Images hinter Artifactory --------------------------------------------------------------------
# BASE_IMAGE=<registry>/python:3.12-slim
# PIP_INDEX_URL=https://<artifactory>/api/pypi/<repo>/simple
# PIP_TRUSTED_HOST=                    # nur wenn pip CERTIFICATE_VERIFY_FAILED meldet
