# Copy to .env on each machine and uncomment ONE machine block. .env is gitignored and never synced; THIS file is
# the shared template - when a value changes on one machine, mirror it here so both stay parallel.
# Read by docker compose (image/ports/volumes + indexer build args) and by the osi CLI (OSI__* runtime settings).

# ============================ machine block: DEV BOX (WSL2) ==================================================
#   make up            -> OpenSearch 3.8.0 on http://127.0.0.1:9200, data in ./data/opensearch, security plugin off
#   make verify        -> version, k-NN plugin, 1024-dim round trip
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0
OPENSEARCH_HEAP=2g
OSI__OPENSEARCH__URL=http://localhost:9200
OSI__EMBEDDING__MODEL=bge-m3
OSI__EMBEDDING__DIM=1024
OSI__EMBEDDING__TEXT_PREFIX=
OSI__ONTOLOGY__PATH=../user-manual-books/handbuch_daten/Ontologie/ontology.yaml

# ============================ machine block: REMOTE SERVER (CentOS/RHEL, podman behind the docker alias, proxy, Artifactory)
#   bash scripts/preflight_image.sh    -> decides how the image gets there (registry mirror / daemon proxy / docker load)
#   make up                            -> compose up -d + scripts/wait_healthy.sh (no `--wait`: podman-compose lacks it)
#   COMPOSE="podman-compose" make up   -> if `docker compose` is not wired to podman on that host
# OPENSEARCH_IMAGE=<artifactory-host>/<docker-remote-repo>/opensearchproject/opensearch:3.8.0
# DASHBOARDS_IMAGE=<artifactory-host>/<docker-remote-repo>/opensearchproject/opensearch-dashboards:3.8.0
# OPENSEARCH_HEAP=2g
# OPENSEARCH_BIND=127.0.0.1               # keep loopback; reach it through an SSH tunnel or from the same host
# OPENSEARCH_DATA=./data/opensearch       # persisted inside this module folder; must be owned by uid 1000 (make init)
# OPENSEARCH_MEMORY_LOCK=true             # false if the log says "memory locking requested ... but memory is not locked"
#                                         # (rootless podman cannot raise the memlock ulimit) - DEPLOY.md §5
# SELINUX_LABEL=,Z                        # SELinux enforcing: relabel bind mounts (verified needed on the server)
#                                         # rootless podman ownership is handled by `make init` (podman unshare chown)
# OSI__OPENSEARCH__URL=http://localhost:9200
# OSI__EMBEDDING__MODEL=intfloat/multilingual-e5-large
# OSI__EMBEDDING__DIM=1024
# OSI__EMBEDDING__TEXT_PREFIX="passage: "
# OSI__ONTOLOGY__PATH=/srv/rag/user-manual-books/handbuch_daten/Ontologie/ontology.yaml
# OUT_DIR=/srv/rag/out                    # mounted read-only into the indexer container as /data/out
# ONTOLOGY_DIR=/srv/rag/user-manual-books/handbuch_daten/Ontologie
#
# ---- indexer image build args (docker compose --profile tools build) ----
# BASE_IMAGE=<registry>/python:3.12-slim
# PIP_INDEX_URL=https://<artifactory>/api/pypi/<repo>/simple
# PIP_TRUSTED_HOST=                       # only if pip reports CERTIFICATE_VERIFY_FAILED
# HTTP_PROXY=http://<proxy>:<port>        # both spellings, as in docling-graph
# HTTPS_PROXY=http://<proxy>:<port>
# NO_PROXY=localhost,127.0.0.1,<artifactory-host>,<registry-host>,.<internal-domain>
# http_proxy=http://<proxy>:<port>
# https_proxy=http://<proxy>:<port>
# no_proxy=localhost,127.0.0.1,<artifactory-host>,<registry-host>,.<internal-domain>

# ============================ later: ENTERPRISE MANAGED CLUSTER (no compose node) ============================
# OSI__OPENSEARCH__URL=https://opensearch.internal:9200
# OSI__OPENSEARCH__USERNAME=rag
# OSI__OPENSEARCH__PASSWORD=<secret>
# OSI__OPENSEARCH__CA_CERTS=/etc/pki/tls/certs/internal-ca.pem
# OSI__INDEX__REPLICAS=1
