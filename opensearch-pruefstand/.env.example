# opensearch-pruefstand/.env — Vorlage. Nach .env kopieren (gitignored). Zelle 1 des Notebooks lädt diese Datei.

# ---- Profil "remote": entfernte OpenSearch-Instanz (Security-Plugin, HTTPS) ------------------------------------
OS_REMOTE_URL=https://opensearch.intern:9200
OS_REMOTE_USER=bhb_test
OS_REMOTE_PASSWORD=
OS_REMOTE_VERIFY=true                  # false nur zum ersten Ausprobieren mit Demo-Zertifikaten
OS_REMOTE_CA=                          # PEM-Bundle der Firmen-CA, z. B. /etc/pki/firmen-ca.pem

# ---- Frage-Embedding für den kNN-Kanal (OpenAI-kompatibel). Leer → Ersatz: gespeicherter Vektor eines Chunks ----
RAG__EMBEDDING__BASE_URL=http://localhost:4000/v1
RAG__EMBEDDING__API_KEY=sk-...
