# Copy to .env and uncomment ONE machine block. .env is gitignored; THIS file is the shared template.
# Read by the rag-retrieve CLI (and by chat-system when the same keys are put into chat-system/.env).
# Never put HTTP(S)_PROXY here: all endpoints are loopback/tunnels and the httpx clients ignore the proxy environment.

# ============================ machine block: DEV BOX (WSL2) ==================================================
#   OpenSearch node from opensearch-index (make up), LiteLLM proxy on :4000 (bge-m3 via Ollama, gemini-dev)
RAG__OPENSEARCH__URL=http://localhost:9200
RAG__INDEX__PREFIX=bhb
RAG__EMBEDDING__BASE_URL=http://localhost:4000/v1
RAG__EMBEDDING__API_KEY=sk-123456789
RAG__EMBEDDING__MODEL=bge-m3
RAG__EMBEDDING__DIM=1024
RAG__EMBEDDING__QUERY_PREFIX=
RAG__LLM__BASE_URL=http://localhost:4000/v1
RAG__LLM__API_KEY=sk-123456789
RAG__LLM__MODEL=gemini-dev
# RAG__LLM__MAX_TOKENS=4000                 # gemini-3.7-flash thinks ~1300 tokens before answering; 1500 truncated answers
# RAG__RETRIEVAL__HISTORY_TURNS=3           # user/assistant pairs the prompt carries (REQ-001 R7); 10 for large-context models
# RAG__GUARDRAIL__MIN_AGREEING_CHANNELS=2 # 1 = any lexical overlap reaches the model; off-topic (BM25 empty) is still refused
# RAG__LLM__MODEL=granite4                  # CPU-only Ollama model: slow, small context -> also set
# RAG__LLM__CONTEXT_LIMIT_TOKENS=4096       #   and RAG__RETRIEVAL__CONTEXT_TOKEN_BUDGET=2500
# RAG__LLM__BASE_URL=http://localhost:11434/v1   # Ollama directly (no key needed), e.g. RAG__LLM__MODEL=gemma4:e2b
RAG__ONTOLOGY__PATH=../user-manual-books/handbuch_daten/Ontologie/ontology.yaml

# ============================ machine block: REMOTE SERVER (vLLM Qwen3-Coder-30B + multilingual-e5-large) ====
#   The chunks there were embedded with intfloat/multilingual-e5-large and the "passage: " prefix (osi status),
#   so the question needs the matching model and the "query: " prefix. Endpoints reached through SSH tunnels.
# RAG__OPENSEARCH__URL=http://localhost:9200
# RAG__EMBEDDING__BASE_URL=http://localhost:11435/v1
# RAG__EMBEDDING__API_KEY=
# RAG__EMBEDDING__MODEL=intfloat/multilingual-e5-large
# RAG__EMBEDDING__DIM=1024
# RAG__EMBEDDING__QUERY_PREFIX="query: "
# RAG__LLM__BASE_URL=http://localhost:11435/v1
# RAG__LLM__API_KEY=
# RAG__LLM__MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
# RAG__LLM__CONTEXT_LIMIT_TOKENS=32000
# RAG__RETRIEVAL__HISTORY_TURNS=10          # the served context is large: keep 10 exchanges in the prompt (REQ-001 R7)
# RAG__GUARDRAIL__MIN_AGREEING_CHANNELS=1 # e5 + book filter: kNN and BM25 rarely agree on the top 3 -> 1 until REQ-001 phases 2-4
# RAG__ONTOLOGY__PATH=/srv/rag/user-manual-books/handbuch_daten/Ontologie/ontology.yaml

# ============================ later: ENTERPRISE MANAGED CLUSTER ==============================================
# RAG__OPENSEARCH__URL=https://opensearch.internal:9200
# RAG__OPENSEARCH__USERNAME=rag
# RAG__OPENSEARCH__PASSWORD=<secret>
# RAG__OPENSEARCH__CA_CERTS=/etc/pki/tls/certs/internal-ca.pem
