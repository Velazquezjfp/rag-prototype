# rag-users reads USERS__* from the environment or from the .env of the working directory.
# Normally these keys live in chat-system/.env next to the CHAT__* and RAG__* keys; this file documents them.

# ---- DEV BOX: fixed identity from the mock directory (dev, otto.ops, rita.read, anna.admin) ----
USERS__ADAPTER=env
USERS__DEV_USER=dev

# ---- BEHIND oauth2-proxy: identity from the headers the ingress injects (unknown users are NOT looked up) ----
# USERS__ADAPTER=header
# USERS__HEADER_USER=X-Forwarded-User
# USERS__HEADER_EMAIL=X-Forwarded-Email
# USERS__HEADER_GROUPS=X-Forwarded-Groups
